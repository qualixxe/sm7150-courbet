#/** @file
#
#  Storage Report - a driver that prints the block devices and their partition
#  names without needing any input.
#
#  It exists because the UEFI Shell has the right commands but the phone has no
#  keyboard, so nothing can be typed into it. Reading a report off the screen
#  needs either a menu entry or a delay at boot, and a menu entry needs a FILE
#  block in the FDF that the build cannot resolve. Printing at ReadyToBoot and
#  holding the screen needs neither.
#
**/

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = StorageReportDxe
  FILE_GUID                      = 3f2a71c4-58d0-4b19-9e6a-0c2f5b8d71a3
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = StorageReportEntryPoint

[Sources]
  StorageReportDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib

[Protocols]
  gEfiBlockIoProtocolGuid              ## CONSUMES

#
# Not under [Protocols]: gEfiEventReadyToBootGuid is a GUID, not a protocol,
# and the build rejects it there with "Value of Protocol is not found".
#
[Guids]
  gEfiEventReadyToBootGuid

#
# Nothing is required for it to run: a report is useful precisely when the machine
# is in a bad state, so it must not depend on the very things it is reporting on.
#
[Depex]
  TRUE